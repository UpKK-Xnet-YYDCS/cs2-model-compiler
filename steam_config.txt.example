# Steam Workshop Upload Configuration
# Copy this file to steam_config.txt and fill in your details

# Steam username (leave empty for anonymous upload)
steam_user=your_steam_username

# Steam password (leave empty for cached login or anonymous)
steam_password=your_steam_password

# Workshop addon directory
workshop_dir=F:/SteamLibrary/steamapps/common/Counter-Strike Global Offensive/game/csgo_addons/upkkmodelpack2026_agents

# SteamCMD directory
steamcmd_dir=F:/SteamCMD
